# ---- W-API ----
# TOKEN DA INSTÂNCIA — painel W-API → sua instância → "TOKEN DA INSTÂNCIA".
# Usado como Bearer nos endpoints /message/*. NÃO confundir com a
# "API Key Master" (essa é só para criar/gerenciar instâncias via API).
WAPI_TOKEN=change-me
# ID DA INSTÂNCIA — painel W-API → sua instância → "ID DA INSTÂNCIA"
# (formato: XXXXXX-XXXXXX-XXXXXX).
WAPI_INSTANCE_ID=change-me
# Base URL of the W-API REST API. Default usually works.
WAPI_BASE_URL=https://api.w-api.app/v1
# Shared secret validated on the inbound webhook. Configure the same value
# in the W-API panel when setting your webhook URL (e.g. as a query string
# ?token=... or header X-Webhook-Token). Must be long and random.
WEBHOOK_SECRET=change-me-long-random-string

# ---- Mistral ----
MISTRAL_API_KEY=change-me
# Any model available to your key. mistral-large-latest is the strongest.
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TEMPERATURE=0.3
MISTRAL_MAX_TOKENS=1024

# ---- Agent ----
# Path to the system prompt (relative to project root).
AGENT_PROMPT_PATH=prompts/system.md
# Max chat turns kept in working memory per user (oldest turns get trimmed).
AGENT_HISTORY_WINDOW=30
# SQLite file holding LangGraph conversation state.
AGENT_CHECKPOINT_DB=data/checkpoints.sqlite
# SQLite file holding runtime state (e.g. per-conversation human-takeover).
AGENT_STATE_DB=data/state.sqlite

# ---- Human takeover ----
# When the instance owner types in WhatsApp, the bot goes silent on that
# conversation for this many seconds before auto-resuming. Set to 0 to
# disable the timed window (only explicit commands will mute).
TAKEOVER_WINDOW_SECONDS=1800
# Messages (case-insensitive, exact match) that pause the bot indefinitely.
TAKEOVER_PAUSE_COMMANDS=!pausar,!pause,!ai off,!bot off
# Messages (case-insensitive, exact match) that immediately resume the bot.
TAKEOVER_RESUME_COMMANDS=!retomar,!resume,!ai on,!bot on

# ---- Server ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of phone numbers (E.164, digits only) allowed to talk
# to the bot. Leave empty to allow everyone.
ALLOWED_SENDERS=
# Comma-separated allow-list for the HTTP Host header (e.g. bot.seudominio.com).
# Leave empty to accept any Host (recommended only behind a trusted proxy).
TRUSTED_HOSTS=
